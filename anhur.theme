<?php

/**
 * @file
 * Remove default color if you apply from theme setting.
 */

/**
 * Implements hook_page_attachments_alter().
 *
 *   Check if current theme has value.
 */
function anhur_page_attachments_alter(array &$attachments) {
  // If you enter color theme in theme settings.
  if (theme_get_setting('current_theme') != NULL) {
    $defatuColor = array_search('anhur/default-color', $attachments['#attached']['library'], TRUE);
    unset($attachments['#attached']['library'][$defatuColor]);
  }

  if (theme_get_setting('anhur_google_font')) {
    $external_google_font = array_search('anhur/anhur-google-font-external', $attachments['#attached']['library'], TRUE);
    unset($attachments['#attached']['library'][$external_google_font]);
    $attachments['#attached']['library'][] = 'anhur/anhur-google-font-local';
  }

}
